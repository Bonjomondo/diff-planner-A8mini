# 20 m × 20 m 蛇形覆盖任务。覆盖范围：x=0~20.0 m，y=0~20.0 m。
# 相邻航点间距均为 2.5 m；飞行高度为 1.0 m，可按现场条件统一修改 z。
# 每个航点到达并悬停后，云台保持 pitch=-45°，水平扫描 -135°~+135°。
# range 模式下 gimbal_yaw_deg 不参与执行；可修改每个点的 gimbal_yaw_min_deg/max_deg。

waypoints:
  - id: 1
    x: 0.0
    y: 0.0
    z: 1.0
    hover_sec: 1.0
    gimbal_mode: range
    gimbal_yaw_min_deg: -135.0
    gimbal_yaw_max_deg: 135.0
    gimbal_pitch_deg: -45.0
    gimbal_settle_sec: 1.0

  - id: 2
    x: 2.5
    y: 0.0
    z: 1.0
    hover_sec: 1.0
    gimbal_mode: range
