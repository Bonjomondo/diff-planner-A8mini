<launch>
  <!-- Isolated test master only: real planner, simulated pose tracking, no hardware nodes. -->
  <param name="/indoor_mission/enabled" value="true" />
  <rosparam param="/indoor_mission/bounds">[-2.0,-2.0,0.3,2.0,2.0,2.5]</rosparam>
  <include file="$(find diff_planner)/launch/include/advanced_param_sim.xml">
    <arg name="drone_id" value="0" />
    <arg name="map_size_x_" value="8" /><arg name="map_size_y_" value="8" /><arg name="map_size_z_" value="4" />
    <arg name="odometry_topic" value="sim_odom" /><arg name="cloud_topic" value="sim_cloud" />
    <arg name="camera_pose_topic" value="unused_pose" /><arg name="depth_topic" value="unused_depth" />
    <arg name="cx" value="320" /><arg name="cy" value="240" /><arg name="fx" value="400" /><arg name="fy" value="400" />
    <arg name="max_vel" value="0.4" /><arg name="max_acc" value="0.6" /><arg name="max_jer" value="2" />
    <arg name="planning_horizon" value="4" /><arg name="use_multitopology_trajs" value="false" />
    <arg name="flight_type" value="1" /><arg name="point_num" value="0" />
    <arg name="point0_x" value="0" /><arg name="point0_y" value="0" /><arg name="point0_z" value="1" />
    <arg name="point1_x" value="0" /><arg name="point1_y" value="0" /><arg name="point1_z" value="1" />
    <arg name="point2_x" value="0" /><arg name="point2_y" value="0" /><arg name="point2_z" value="1" />
    <arg name="point3_x" value="0" /><arg name="point3_y" value="0" /><arg name="point3_z" value="1" />
    <arg name="point4_x" value="0" /><arg name="point4_y" value="0" /><arg name="point4_z" value="1" />
  </include>
  <param name="/drone_0_diff_planner_node/fsm/realworld_experiment" value="false" />
  <param name="/drone_0_diff_planner_node/fsm/mondify_final_goal" value="false" />
  <node pkg="diff_planner" type="traj_server" name="drone_0_traj_server" output="screen">
    <remap from="position_cmd" to="/test/position_cmd" />
    <remap from="~planning/trajectory" to="/drone_0_planning/trajectory" />
    <param name="traj_server/time_forward" value="0.0" />
  </node>
  <node pkg="multipoint" type="multipointplan" name="multipointplan" output="screen">
    <param name="mission_source" value="remote" /><param name="enable_rc" value="false" />
    <param name="require_flight_ready" value="true" /><param name="require_map_coordinates" value="true" />
    <param name="enable_gimbal_actions" value="false" />
    <param name="position_tolerance" value="0.15" /><param name="arrival_stable_sec" value="0.15" />
    <remap from="odom_topic" to="/ekf/ekf_odom" />
  </node>
  <include file="$(find multipoint)/launch/gcs_gateway.launch"><arg name="port" value="18765" /></include>
  <test pkg="multipoint" type="test_point_roundtrip_planner.py" name="remote_integration"
        test-name="point_roundtrip_planner" time-limit="65" />
</launch>
