<launch>
    <arg name="odom_topic" default="/ekf/ekf_odom" />
    <arg name="yaml_path" default="$(find multipoint)/config/points.yaml" />
    <arg name="next_distance" default="0.7" />
    <arg name="velocity_tolerance" default="0.2" />
    <arg name="arrival_stable_sec" default="0.5" />
    <arg name="gimbal_retry_sec" default="12.0" />
    <arg name="land_command_retry_sec" default="1.0" />
    <arg name="start_plan" default="1" />
    <arg name="back_plan" default="1" />
    <arg name="enable_rc" default="true" />
    <arg name="mission_csv_path" default="/tmp/a8mini_mission_timestamps.csv" />

    <!-- start_detection=false 可禁止启动；实际识别还受任务 YAML 开关控制。 -->
    <arg name="start_detection" default="true" />
    <arg name="detection_config" default="$(find multipoint)/config/a8mini_detection.yaml" />
    <arg name="start_gimbal_node" default="true" />
    <arg name="camera_ip" default="192.168.144.25" />
    <arg name="camera_port" default="37260" />
    <arg name="gimbal_command_timeout_sec" default="1.2" />
    <arg name="gimbal_command_retries" default="5" />
    <arg name="gimbal_move_wait_sec" default="2.0" />
    <arg name="gimbal_range_move_wait_sec" default="4.0" />
    <!-- 未传 launch 覆盖值时，使用任务 YAML 中的 enable_auto_recording。 -->
    <arg name="enable_auto_recording" default="" />
    <arg name="flight_state_topic" default="/mavros/extended_state" />
    <arg name="record_verify_timeout_sec" default="3.0" />
    <arg name="record_verify_poll_sec" default="0.2" />
    <arg name="record_retry_sec" default="2.0" />

    <node pkg="multipoint" name="multipointplan" type="multipointplan" output="screen">
        <remap from="odom_topic" to="$(arg odom_topic)" />
        <param name="yaml_path" value="$(arg yaml_path)" />
        <param name="position_tolerance" value="$(arg next_distance)" />
        <param name="velocity_tolerance" value="$(arg velocity_tolerance)" />
        <param name="arrival_stable_sec" value="$(arg arrival_stable_sec)" />
        <param name="gimbal_retry_sec" value="$(arg gimbal_retry_sec)" />
        <param name="land_command_retry_sec" value="$(arg land_command_retry_sec)" />
        <param name="start_plan" value="$(arg start_plan)" />
        <param name="back_plan" value="$(arg back_plan)" />
        <param name="enable_rc" value="$(arg enable_rc)" />
        <param name="mission_csv_path" value="$(arg mission_csv_path)" />
    </node>

    <group if="$(arg start_gimbal_node)">
        <node pkg="multipoint" name="a8mini_gimbal" type="a8mini_gimbal_node.py" output="screen">
            <param name="camera_ip" value="$(arg camera_ip)" />
            <param name="camera_port" value="$(arg camera_port)" />
            <param name="move_wait_sec" value="$(arg gimbal_move_wait_sec)" />
            <param name="range_move_wait_sec" value="$(arg gimbal_range_move_wait_sec)" />
            <rosparam command="load" file="$(arg yaml_path)" />
            <param name="command_timeout_sec" value="$(arg gimbal_command_timeout_sec)" />
            <param name="command_retries" value="$(arg gimbal_command_retries)" />
            <param if="$(eval arg('enable_auto_recording') != '')" name="enable_auto_recording" value="$(arg enable_auto_recording)" type="bool" />
            <param name="flight_state_topic" value="$(arg flight_state_topic)" />
            <param name="record_verify_timeout_sec" value="$(arg record_verify_timeout_sec)" />
            <param name="record_verify_poll_sec" value="$(arg record_verify_poll_sec)" />
            <param name="record_retry_sec" value="$(arg record_retry_sec)" />
            <param name="dry_run" value="false" />
        </node>
    </group>
    <include if="$(arg start_detection)" file="$(find multipoint)/launch/a8mini_detection.launch">
        <arg name="yaml_path" value="$(arg yaml_path)" />
        <arg name="detection_config" value="$(arg detection_config)" />
    </include>
</launch>
