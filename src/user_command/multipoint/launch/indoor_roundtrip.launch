<launch>
  <!-- Automatic task adapter only; sensors/planner/controller are started separately. -->
  <param name="/multipointplan/automatic_roundtrip" value="true" />
  <param name="/multipointplan/require_map_coordinates" value="true" />
  <!-- 地图/围栏校验连续失效多久才中止。实测单帧毛刺后重建 10 对需 1.0 s，
       加网关 5 Hz 发布延迟共约 1.1~1.2 s，故取 1.5 s 以吸收单帧毛刺；
       降落阶段本身不中止（见 multipointplan.cpp）。 -->
  <param name="/multipointplan/map_gate_debounce_sec" value="1.5" />
  <include file="$(find multipoint)/launch/multipointplan_exp_lio.launch">
    <arg name="mission_source" value="remote" />
    <arg name="start_gimbal_node" value="false" />
    <arg name="start_detection" value="false" />
    <arg name="enable_rc" value="false" />
    <arg name="start_plan" value="0" />
    <arg name="back_plan" value="0" />
    <!-- 到目标 P 的三维距离门槛，单位：米；(距离目标点多少会被判定到达目标点)-->
    <arg name="next_distance" value="0.2" />
  </include>
</launch>
